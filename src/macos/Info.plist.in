<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleDisplayName</key>
    <string>@MBTOOLS_MACOS_BUNDLE_DISPLAY_NAME@</string>
    <key>CFBundleExecutable</key>
    <string>@MBTOOLS_MACOS_BUNDLE_EXECUTABLE@</string>
    <key>CFBundleGetInfoString</key>
    <string>@MBTOOLS_MACOS_BUNDLE_DISPLAY_NAME@ @PROJECT_VERSION@</string>
    <key>CFBundleIconFile</key>
    <string>@MBTOOLS_MACOS_BUNDLE_ICON@</string>
    <key>CFBundleIdentifier</key>
    <string>@MBTOOLS_MACOS_BUNDLE_IDENTIFIER@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@MBTOOLS_MACOS_BUNDLE_DISPLAY_NAME@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>10.13</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
